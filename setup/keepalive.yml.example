# Vzor GitHub Actions: raz denne zobudí bezplatnú databázu Supabase.
# Skopírujte do .github/workflows/keepalive.yml a doplňte URL a verejný (anon) kľúč
# VÁŠHO projektu MEDEKO – nikdy kľúč inej firmy.
name: Supabase keep-alive
on:
  schedule:
    - cron: "15 5 * * *"   # 06:15 stredoeurópsky čas v zime (05:15 UTC)
  workflow_dispatch:
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping keepalive
        run: |
          curl -fsS -X POST "https://VÁŠ_REF.supabase.co/rest/v1/rpc/keepalive" \
            -H "apikey: VÁŠ_ANON_KĽÚČ" -H "Content-Type: application/json" -d '{}'
